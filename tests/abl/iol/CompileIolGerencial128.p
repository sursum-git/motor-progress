/* Future migration only: run on a licensed OE12.8 compiler connected to the real
   espec schema. Does not activate the parameter and never writes business data. */
BLOCK-LEVEL ON ERROR UNDO, THROW.
DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE iMajor AS INTEGER NO-UNDO.
DEFINE VARIABLE iMinor AS INTEGER NO-UNDO.
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
ASSIGN iMajor=INTEGER(ENTRY(1,PROVERSION,".")) iMinor=INTEGER(ENTRY(2,PROVERSION,".")) NO-ERROR.
IF ERROR-STATUS:ERROR OR iMajor<12 OR (iMajor=12 AND iMinor<8) THEN RETURN ERROR "OE128_COMPILER_REQUIRED".
IF NOT CONNECTED("espec") THEN RETURN ERROR "ESPEC_SCHEMA_REQUIRED".
OUTPUT TO "compile-iol128.log".
PUT UNFORMATTED "OpenEdge " PROVERSION " database=" PDBNAME("espec") SKIP.
COMPILE IolGerencialAggregate128.p SAVE NO-ERROR.
failed=COMPILER:ERROR OR ERROR-STATUS:ERROR.
DO i=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(i) SKIP. END.
PUT UNFORMATTED (IF failed THEN "FAIL COMPILE128" ELSE "PASS COMPILE128; parameter unchanged; validate migrated PASOE before activation") SKIP.
OUTPUT CLOSE.
