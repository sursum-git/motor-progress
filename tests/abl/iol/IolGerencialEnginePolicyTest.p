BLOCK-LEVEL ON ERROR UNDO, THROW.
DEFINE VARIABLE cResult AS CHARACTER NO-UNDO.
DEFINE VARIABLE iChecks AS INTEGER NO-UNDO.
RUN Accept("12.2","12.2.17","",FALSE,"12.2").
RUN Accept("12.2","12.8.0","",TRUE,"12.2").
RUN Accept("12.8","12.8.0","",TRUE,"12.8").
RUN Accept("12.8","12.8.12","READ-ONLY",TRUE,"12.8").
RUN Reject("12.8","12.2.17","",TRUE,"IOL_ENGINE_UNAVAILABLE").
RUN Reject("12.8","12.8.0","AGGREGATE",TRUE,"IOL_ENGINE_UNAVAILABLE").
RUN Reject("12.8","12.8.0","READ-ONLY, AGGREGATE",TRUE,"IOL_ENGINE_UNAVAILABLE").
RUN Reject("12.8","12.8.0",?,TRUE,"IOL_ENGINE_UNAVAILABLE").
RUN Reject("12.8","12.8.0","",FALSE,"IOL_ENGINE_UNAVAILABLE").
RUN Reject("12.8","12.8.0","",?,"IOL_ENGINE_UNAVAILABLE").
RUN Reject("12.8","invalid","",TRUE,"IOL_ENGINE_UNAVAILABLE").
RUN Reject("","12.8.0","",TRUE,"IOL_ENGINE_INVALID").
RUN Reject("13.0","12.8.0","",TRUE,"IOL_ENGINE_INVALID").
RUN Reject(?,"12.8.0","",TRUE,"IOL_ENGINE_INVALID").
OUTPUT TO VALUE("engine-policy-" + SESSION:NUMERIC-FORMAT + ".log").
PUT UNFORMATTED "PASS engine policy checks=" iChecks SKIP.
OUTPUT CLOSE.
PROCEDURE Accept:
 DEFINE INPUT PARAMETER pcEngine AS CHARACTER NO-UNDO.
 DEFINE INPUT PARAMETER pcVersion AS CHARACTER NO-UNDO.
 DEFINE INPUT PARAMETER pcRestrictions AS CHARACTER NO-UNDO.
 DEFINE INPUT PARAMETER plArtifact AS LOGICAL NO-UNDO.
 DEFINE INPUT PARAMETER pcExpected AS CHARACTER NO-UNDO.
 RUN IolGerencialEnginePolicy.p(pcEngine,pcVersion,pcRestrictions,plArtifact,OUTPUT cResult).
 IF cResult<>pcExpected THEN UNDO, THROW NEW Progress.Lang.AppError("FAIL accepted engine",1).
 iChecks=iChecks + 1.
END PROCEDURE.
PROCEDURE Reject:
 DEFINE INPUT PARAMETER pcEngine AS CHARACTER NO-UNDO.
 DEFINE INPUT PARAMETER pcVersion AS CHARACTER NO-UNDO.
 DEFINE INPUT PARAMETER pcRestrictions AS CHARACTER NO-UNDO.
 DEFINE INPUT PARAMETER plArtifact AS LOGICAL NO-UNDO.
 DEFINE INPUT PARAMETER pcExpected AS CHARACTER NO-UNDO.
 DEFINE VARIABLE cError AS CHARACTER NO-UNDO.
 DO ON ERROR UNDO, THROW:
  RUN IolGerencialEnginePolicy.p(pcEngine,pcVersion,pcRestrictions,plArtifact,OUTPUT cResult).
  CATCH e AS Progress.Lang.Error: cError=e:GetMessage(1). END CATCH.
 END.
 IF cError<>pcExpected THEN UNDO, THROW NEW Progress.Lang.AppError("FAIL engine rejection: " + pcExpected,1).
 iChecks=iChecks + 1.
END PROCEDURE.
