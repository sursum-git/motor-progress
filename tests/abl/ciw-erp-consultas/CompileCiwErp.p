DEFINE VARIABLE programs AS CHARACTER NO-UNDO INITIAL 'CiwErpReadService.p,CiwMedCompanyContext.p,CiwCadastrosCrud.p,CiwErpReadTest.p'.
DEFINE VARIABLE n AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
OUTPUT TO 'compile-ciw-erp.log'.
PUT UNFORMATTED 'OpenEdge ' PROVERSION ' NUMDBS=' NUM-DBS SKIP.
DO n=1 TO NUM-ENTRIES(programs):
 COMPILE VALUE(ENTRY(n,programs)) SAVE NO-ERROR.
 PUT UNFORMATTED ENTRY(n,programs) ' COMPILER:ERROR=' COMPILER:ERROR SKIP.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE. QUIT.
