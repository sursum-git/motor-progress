DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE lFailed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-parametros-real.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
COMPILE "VerificarParametrosIma.p" SAVE NO-ERROR.
lFailed = COMPILER:ERROR.
PUT UNFORMATTED "VerificarParametrosIma COMPILER:ERROR=" lFailed SKIP.
DO i = 1 TO ERROR-STATUS:NUM-MESSAGES:
    PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(i) SKIP.
END.
IF NOT lFailed THEN PUT UNFORMATTED "PASS: compile 12.2 parametros sem cache" SKIP.
OUTPUT CLOSE.
QUIT.
