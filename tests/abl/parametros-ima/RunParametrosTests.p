DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE lFailed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-parametros.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
COMPILE "ParametrosImaTest.p" SAVE NO-ERROR.
lFailed = COMPILER:ERROR.
DO i = 1 TO ERROR-STATUS:NUM-MESSAGES:
    PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(i) SKIP.
END.
PUT UNFORMATTED "ParametrosImaTest COMPILER:ERROR=" lFailed SKIP.
OUTPUT CLOSE.
IF NOT lFailed THEN RUN ParametrosImaTest.p.
QUIT.
