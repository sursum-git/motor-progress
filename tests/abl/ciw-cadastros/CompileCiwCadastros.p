DEFINE VARIABLE nameValue AS CHARACTER NO-UNDO.
DEFINE VARIABLE n AS INTEGER NO-UNDO.
DEFINE VARIABLE k AS INTEGER NO-UNDO.
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-ciw-cadastros.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO n = 1 TO 5:
 nameValue=ENTRY(n,"CiwCadastroCrudService.p,CiwCadastroCrudTest.p,CiwCadastroDefinition.p,CiwCadastrosCrud.p,CiwCadastroDefinitionTest.p").
 COMPILE VALUE(nameValue) SAVE NO-ERROR.
 PUT UNFORMATTED nameValue " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 IF COMPILER:ERROR THEN failed=TRUE.
 DO k = 1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(k) SKIP. END.
END.
OUTPUT CLOSE.
IF NOT failed THEN DO:
 SESSION:NUMERIC-FORMAT="AMERICAN". RUN CiwCadastroCrudTest.p.
 SESSION:NUMERIC-FORMAT="EUROPEAN". RUN CiwCadastroCrudTest.p.
END.
QUIT.
