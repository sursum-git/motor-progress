DEFINE VARIABLE i AS INTEGER NO-UNDO.
OS-CREATE-DIR "temp" NO-ERROR.
PROPATH = "sursum-api/sursum,sursum-api/rest," + PROPATH.
OUTPUT TO "temp/compile-json-router.txt".
COMPILE "JsonProgramRouter.cls" SAVE NO-ERROR.
IF COMPILER:ERROR THEN DO:
 DO i = 1 TO ERROR-STATUS:NUM-MESSAGES:
  PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(i) SKIP.
 END.
 PUT UNFORMATTED "ROUTER COMPILE FAILED" SKIP.
 OUTPUT CLOSE.
 QUIT.
END.
COMPILE "tests/abl/JsonProgramRouterTest.p" SAVE NO-ERROR.
DO i = 1 TO ERROR-STATUS:NUM-MESSAGES:
 PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(i) SKIP.
END.
IF COMPILER:ERROR THEN DO:
 PUT UNFORMATTED "COMPILE FAILED" SKIP.
 OUTPUT CLOSE.
 QUIT.
END.
OUTPUT CLOSE.
RUN tests/abl/JsonProgramRouterTest.p.
