DEFINE VARIABLE names AS CHARACTER NO-UNDO INITIAL "CiwParametrosService.p,CiwCadastrosCrud.p,CiwParametrosTest.p,CiwDespesasImpostosTest.p".
DEFINE VARIABLE n AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
OUTPUT TO "compile-ciw-parametros.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO n=1 TO NUM-ENTRIES(names):
 COMPILE VALUE(ENTRY(n,names)) SAVE NO-ERROR.
 PUT UNFORMATTED ENTRY(n,names) " COMPILER:ERROR=" COMPILER:ERROR SKIP.
 DO j=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP. END.
END.
OUTPUT CLOSE.
QUIT.
