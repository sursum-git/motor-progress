DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE cFile AS CHARACTER NO-UNDO.
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
/* Somente runner isolado; o servico nunca altera configuracao da sessao. */
IF SESSION:PARAMETER = "AMERICAN" OR SESSION:PARAMETER = "EUROPEAN" THEN
 SESSION:NUMERIC-FORMAT = SESSION:PARAMETER.
OUTPUT TO "compile-despesas-tests.log".
PUT UNFORMATTED "OpenEdge " PROVERSION " FORMAT=" SESSION:NUMERIC-FORMAT SKIP.
DO j=1 TO 3:
 cFile=ENTRY(j,"DespesasCrudService.p,DespesasCrud.p,DespesasCrudTest.p").
 IF SEARCH(cFile)=? THEN NEXT.
 COMPILE VALUE(cFile) SAVE NO-ERROR.
 failed=COMPILER:ERROR.
 PUT UNFORMATTED cFile " COMPILER:ERROR=" failed SKIP.
 DO i=1 TO ERROR-STATUS:NUM-MESSAGES: PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(i) SKIP. END.
 IF failed THEN LEAVE.
END.
OUTPUT CLOSE.
IF NOT failed THEN RUN DespesasCrudTest.p.
QUIT.
