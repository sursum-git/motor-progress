DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE f AS CHARACTER NO-UNDO.
DEFINE VARIABLE failed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-despesas.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO j=1 TO 4:
 f=ENTRY(j,"DespesasCrudService.p,DespesasCrud.p,DespesasCrudTest.p,DespesasDbReadTest.p").
 COMPILE VALUE(f) SAVE NO-ERROR.
 failed=COMPILER:ERROR.
 PUT UNFORMATTED f " COMPILER:ERROR=" failed SKIP.
 DO i=1 TO ERROR-STATUS:NUM-MESSAGES:
  PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(i) SKIP.
 END.
 IF failed THEN LEAVE.
END.
IF NOT failed THEN PUT UNFORMATTED "PASS: compile 12.2 despesas" SKIP.
OUTPUT CLOSE.
IF NOT failed AND CONNECTED("espec") THEN RUN DespesasDbReadTest.p.
QUIT.
