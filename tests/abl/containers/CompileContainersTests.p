/* Runner isolado de compilacao/teste; nunca publicar no PASOE. */
DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE cSource AS CHARACTER NO-UNDO.
DEFINE VARIABLE cSources AS CHARACTER NO-UNDO.
DEFINE VARIABLE lFailed AS LOGICAL NO-UNDO.
/* Wrapper exige schema real na compilacao 12.2; staging local nao o copia. */
cSources = "ContainersConsultaService.p,ContainersConsultaTest.p".
IF SEARCH("ContainersConsulta.p") <> ? THEN cSources = cSources + ",ContainersConsulta.p".
OUTPUT TO "compile-containers-tests-AMERICAN.log".
PUT UNFORMATTED "OpenEdge " PROVERSION SKIP.
DO i = 1 TO NUM-ENTRIES(cSources):
  cSource = ENTRY(i, cSources).
  COMPILE VALUE(cSource) SAVE NO-ERROR.
  PUT UNFORMATTED cSource " COMPILER:ERROR=" COMPILER:ERROR SKIP.
  IF COMPILER:ERROR OR ERROR-STATUS:ERROR THEN lFailed = TRUE.
  DO j = 1 TO ERROR-STATUS:NUM-MESSAGES:
    PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP.
  END.
END.
OUTPUT CLOSE.
IF NOT lFailed THEN DO i = 1 TO 2:
  SESSION:NUMERIC-FORMAT = ENTRY(i, "AMERICAN,EUROPEAN").
  RUN ContainersConsultaTest.p NO-ERROR.
  OUTPUT TO "compile-containers-tests-AMERICAN.log" APPEND.
  IF ERROR-STATUS:ERROR THEN DO:
    lFailed = TRUE.
    PUT UNFORMATTED "FAIL NUMERIC-FORMAT=" SESSION:NUMERIC-FORMAT SKIP.
    DO j = 1 TO ERROR-STATUS:NUM-MESSAGES:
      PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP.
    END.
  END.
  ELSE PUT UNFORMATTED "PASS NUMERIC-FORMAT=" SESSION:NUMERIC-FORMAT SKIP.
  OUTPUT CLOSE.
END.
OUTPUT TO "compile-containers-tests-AMERICAN.log" APPEND.
PUT UNFORMATTED (IF lFailed THEN "FAIL CONTAINERS" ELSE "PASS CONTAINERS") SKIP.
OUTPUT CLOSE.
QUIT.
