DEFINE VARIABLE cSource AS CHARACTER NO-UNDO.
DEFINE VARIABLE cSources AS CHARACTER NO-UNDO INITIAL "PasoeExecutionContext.cls,IdentityTest.p".
DEFINE VARIABLE i AS INTEGER NO-UNDO.
DEFINE VARIABLE j AS INTEGER NO-UNDO.
DEFINE VARIABLE lFailed AS LOGICAL NO-UNDO.
OUTPUT TO "compile-identity.log".
IF SEARCH("PasoeRuntimeIdentity.cls") <> ? THEN cSources = "PasoeRuntimeIdentity.cls," + cSources.
DO i = 1 TO NUM-ENTRIES(cSources):
  cSource = ENTRY(i, cSources).
  COMPILE VALUE(cSource) SAVE NO-ERROR.
  PUT UNFORMATTED cSource " COMPILER:ERROR=" COMPILER:ERROR SKIP.
  IF COMPILER:ERROR THEN lFailed = TRUE.
  DO j = 1 TO ERROR-STATUS:NUM-MESSAGES:
    PUT UNFORMATTED ERROR-STATUS:GET-MESSAGE(j) SKIP.
  END.
END.
PUT UNFORMATTED (IF lFailed THEN "FAIL: compile" ELSE "PASS: compile 12.2") SKIP.
OUTPUT CLOSE.
QUIT.
