/* Resolucao fechada MED, reutilizavel. Mesma correspondencia EMS2=5 do leitor
   financeiro existente; o codigo EMS5 vem do cadastro, nunca e presumido. */
BLOCK-LEVEL ON ERROR UNDO, THROW.
DEFINE INPUT PARAMETER phEmpresas AS HANDLE NO-UNDO.
DEFINE OUTPUT PARAMETER pcEms5 AS CHARACTER NO-UNDO.
DEFINE VARIABLE b AS HANDLE NO-UNDO.
DEFINE VARIABLE q AS HANDLE NO-UNDO.
DEFINE VARIABLE totalValue AS INTEGER NO-UNDO.
DEFINE VARIABLE codeValue AS INTEGER NO-UNDO.
DO ON ERROR UNDO, THROW:
 IF NOT VALID-HANDLE(phEmpresas) THEN UNDO,THROW NEW Progress.Lang.AppError('CIW_ERP_COMPANY_UNAVAILABLE',0).
 CREATE BUFFER b FOR TABLE phEmpresas BUFFER-NAME 'bCiwMedCompany'. CREATE QUERY q. q:SET-BUFFERS(b).
 IF NOT q:QUERY-PREPARE('FOR EACH ' + b:NAME + ' WHERE ' + b:NAME + '.cod_emp_ems2 = 5 NO-LOCK') THEN UNDO,THROW NEW Progress.Lang.AppError('CIW_ERP_COMPANY_UNAVAILABLE',0).
 q:QUERY-OPEN(). q:GET-FIRST(NO-LOCK).
 DO WHILE NOT q:QUERY-OFF-END:
  totalValue=totalValue + 1.
  codeValue=b:BUFFER-FIELD('cod_emp_ems5'):BUFFER-VALUE.
  IF totalValue>1 THEN UNDO,THROW NEW Progress.Lang.AppError('CIW_ERP_COMPANY_AMBIGUOUS',0).
  q:GET-NEXT(NO-LOCK).
 END.
 IF totalValue<>1 OR codeValue=? OR codeValue<0 THEN UNDO,THROW NEW Progress.Lang.AppError('CIW_ERP_COMPANY_UNAVAILABLE',0).
 pcEms5=TRIM(STRING(codeValue,'->>>>>>>>>9')).
 FINALLY:
  IF VALID-HANDLE(q) THEN DELETE OBJECT q NO-ERROR.
  IF VALID-HANDLE(b) THEN DELETE OBJECT b NO-ERROR.
 END FINALLY.
END.
