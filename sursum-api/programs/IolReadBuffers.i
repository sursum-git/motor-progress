/* Private buffer helpers. Caller constructs all sources; never accept query text from HTTP. */
DEFINE TEMP-TABLE ttIolQuery NO-UNDO FIELD queryHandle AS HANDLE INDEX ix queryHandle.
FUNCTION FieldHandle RETURNS HANDLE (n AS INTEGER,c AS CHARACTER):
 IF n<1 OR n>20 OR NOT VALID-HANDLE(phSources[n]) THEN UNDO, THROW NEW Progress.Lang.AppError("IOL_CONFIGURATION",1).
 RETURN phSources[n]:BUFFER-FIELD(c).
END FUNCTION.
FUNCTION FieldName RETURNS CHARACTER (n AS INTEGER,c AS CHARACTER):
 RETURN phSources[n]:NAME + "." + c.
END FUNCTION.
FUNCTION TextValue RETURNS CHARACTER (n AS INTEGER,c AS CHARACTER):
 DEFINE VARIABLE v AS CHARACTER NO-UNDO.
 v=STRING(FieldHandle(n,c):BUFFER-VALUE).
 IF v=? THEN UNDO, THROW NEW Progress.Lang.AppError("IOL_DATA_INVALID",1).
 RETURN v.
END FUNCTION.
FUNCTION NumValue RETURNS DECIMAL (n AS INTEGER,c AS CHARACTER):
 DEFINE VARIABLE v AS DECIMAL DECIMALS 10 NO-UNDO.
 v=FieldHandle(n,c):BUFFER-VALUE.
 IF v=? THEN UNDO, THROW NEW Progress.Lang.AppError("IOL_DATA_INVALID",1).
 RETURN v.
END FUNCTION.
FUNCTION OpenJoin RETURNS HANDLE (indexes AS CHARACTER,statement AS CHARACTER):
 DEFINE VARIABLE q AS HANDLE NO-UNDO.
 DEFINE VARIABLE n AS INTEGER NO-UNDO.
 CREATE QUERY q.
 CREATE ttIolQuery. ttIolQuery.queryHandle=q.
 DO n=1 TO NUM-ENTRIES(indexes): q:ADD-BUFFER(phSources[INTEGER(ENTRY(n,indexes))]). END.
 IF NOT q:QUERY-PREPARE(statement) THEN UNDO, THROW NEW Progress.Lang.AppError("IOL_QUERY_INVALID",1).
 q:QUERY-OPEN(). q:GET-FIRST().
 RETURN q.
END FUNCTION.
FUNCTION OpenRows RETURNS HANDLE (n AS INTEGER,condition AS CHARACTER):
 RETURN OpenJoin(STRING(n),"FOR EACH " + phSources[n]:NAME + " NO-LOCK WHERE " + condition).
END FUNCTION.
FUNCTION FindRow RETURNS LOGICAL (n AS INTEGER,condition AS CHARACTER):
 DEFINE VARIABLE foundRow AS LOGICAL NO-UNDO.
 foundRow=phSources[n]:FIND-FIRST("WHERE " + condition,NO-LOCK) NO-ERROR.
 RETURN foundRow=TRUE.
END FUNCTION.
PROCEDURE CloseRows:
 DEFINE INPUT PARAMETER q AS HANDLE NO-UNDO.
 IF VALID-HANDLE(q) THEN DO: q:QUERY-CLOSE(). DELETE OBJECT q. END.
 FOR FIRST ttIolQuery WHERE ttIolQuery.queryHandle=q: DELETE ttIolQuery. END.
END PROCEDURE.
PROCEDURE ReleaseQueries:
 FOR EACH ttIolQuery:
  IF VALID-HANDLE(ttIolQuery.queryHandle) THEN DO:
   ttIolQuery.queryHandle:QUERY-CLOSE(). DELETE OBJECT ttIolQuery.queryHandle.
  END.
  DELETE ttIolQuery.
 END.
END PROCEDURE.
