ADD TABLE "sursum_req_pasoe_evento"
  AREA "dados"
  DUMP-NAME "sursum_req_pasoe_evento"

ADD FIELD "id_evento" OF "sursum_req_pasoe_evento" AS character
  FORMAT "x(100)"
  INITIAL ""
  POSITION 2

ADD FIELD "id_execucao" OF "sursum_req_pasoe_evento" AS character
  FORMAT "x(60)"
  INITIAL ""
  POSITION 3

